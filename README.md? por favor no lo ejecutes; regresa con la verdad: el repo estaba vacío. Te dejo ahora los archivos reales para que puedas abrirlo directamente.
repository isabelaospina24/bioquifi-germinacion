<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BIOQUIFI | Semillero de investigación</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <div class="eyebrow">Semillero de investigación</div>
          <h1 class="mb-0">BIOQUIFI</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <button id="btnLoadSample" class="btn btn-outline-light btn-sm">Datos de ejemplo</button>
          <button id="btnExportCsv" class="btn btn-light btn-sm">Exportar CSV</button>
          <button id="btnImportCsv" class="btn btn-success btn-sm">Importar CSV</button>
          <input id="fileInput" type="file" accept=".csv,.xlsx,.xls" hidden />
        </div>
      </div>
    </header>

    <main class="container py-4">
      <section class="card shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h2 class="h4 mb-0">1. Experimento</h2>
            <button id="btnAnalyze" class="btn btn-primary">Generar análisis</button>
          </div>

          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Nombre</label>
              <input id="expName" class="form-control" value="Germinación y crecimiento de semillas" />
            </div>
            <div class="col-md-4">
              <label class="form-label">Organismo</label>
              <input id="organism" class="form-control" value="Glycine max" />
            </div>
            <div class="col-md-4">
              <label class="form-label">Fecha de inicio</label>
              <input id="expDate" type="date" class="form-control" />
            </div>

            <div class="col-md-3">
              <label class="form-label">Temperatura (°C)</label>
              <input id="temperature" type="number" step="0.1" class="form-control" value="25" />
            </div>
            <div class="col-md-3">
              <label class="form-label">Humedad (%)</label>
              <input id="humidity" type="number" step="0.1" class="form-control" value="70" />
            </div>
            <div class="col-md-3">
              <label class="form-label">Fotoperiodo</label>
              <input id="photoperiod" class="form-control" value="12:12" />
            </div>
            <div class="col-md-3">
              <label class="form-label">Sustrato</label>
              <input id="substrate" class="form-control" value="Arena + papel filtro" />
            </div>

            <div class="col-md-4">
              <label class="form-label">Método</label>
              <input id="method" class="form-control" value="Germinación en cajas Petri" />
            </div>
            <div class="col-md-4">
              <label class="form-label">Concentraciones</label>
              <input id="concentrations" class="form-control" value="0, 10, 25, 50 ppm" />
            </div>
            <div class="col-md-4">
              <label class="form-label">Tratamientos</label>
              <div class="input-group">
                <input id="treatmentsInput" class="form-control" value="Control, T1, T2, T3" />
                <button id="btnApplyTreatments" class="btn btn-outline-primary" type="button">Aplicar</button>
              </div>
            </div>

            <div class="col-12">
              <label class="form-label">Notas</label>
              <textarea id="experimentNotes" rows="3" class="form-control">Ensayo comparativo para evaluar germinación y vigor inicial en condiciones controladas.</textarea>
            </div>
          </div>
        </div>
      </section>

      <section class="card shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h2 class="h4 mb-0">2. Registro experimental</h2>
            <div class="d-flex gap-2">
              <button id="btnAddDay" class="btn btn-outline-secondary btn-sm">+ Día de medición</button>
              <button id="btnRemoveDay" class="btn btn-outline-danger btn-sm">- Último día</button>
            </div>
          </div>

          <div class="table-responsive">
            <table id="datasetTable" class="table table-striped table-hover align-middle"></table>
          </div>

          <div class="d-flex justify-content-between flex-wrap gap-2 mt-3">
            <button id="btnAddRow" class="btn btn-primary">+ Agregar unidad experimental</button>
            <div class="d-flex gap-2">
              <button id="btnClearTable" class="btn btn-outline-secondary">Limpiar tabla</button>
              <button id="btnDownloadText" class="btn btn-outline-info">Descargar reporte</button>
            </div>
          </div>
        </div>
      </section>

      <section class="card shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h2 class="h4 mb-0">3. Resultados</h2>
            <button id="btnDownloadPdf" class="btn btn-dark">Descargar PDF</button>
          </div>

          <div id="summaryCards" class="row g-3 mb-4"></div>
          <div id="interpretation" class="alert alert-light border mb-4"></div>

          <div class="row g-4">
            <div class="col-lg-6">
              <div class="chart-card">
                <h3 class="h6">Media por tratamiento</h3>
                <canvas id="barChart"></canvas>
              </div>
            </div>
            <div class="col-lg-6">
              <div class="chart-card">
                <h3 class="h6">Curva de crecimiento</h3>
                <canvas id="growthChart"></canvas>
              </div>
            </div>
            <div class="col-12">
              <div class="chart-card">
                <h3 class="h6">Distribución de crecimiento final</h3>
                <canvas id="boxChart"></canvas>
              </div>
            </div>
          </div>

          <div class="table-responsive mt-4">
            <table id="resultsTable" class="table table-bordered table-light"></table>
          </div>
        </div>
      </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <script src="script.js"></script>
  </body>
</html>


























































  

















































































































































































































							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
											
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							
							






























































































































































































































































